{
  "scanner_output_path": "data/current_candidate_envelope.json",
  "state_path": "data/apex_packet_monitor_state.json",
  "log_path": "logs/apex_packet_monitor.jsonl",
  "transport": {
    "type": "local_file",
    "inbox_dir": "data/codex_inbox"
  },
  "loop": {
    "interval_seconds": 4,
    "max_iterations": null
  },
  "freshness": {
    "max_quote_age_seconds": 420,
    "max_provenance_age_seconds": 420
  },
  "viability": {
    "min_apex_score": 75,
    "min_confidence": 0.65
  },
  "retry": {
    "max_attempts": 3,
    "base_backoff_seconds": 1.0,
    "max_backoff_seconds": 30.0
  },
  "rate_limit": {
    "min_emit_interval_seconds": 0
  },
  "circuit_breaker": {
    "failure_threshold": 3,
    "cooldown_seconds": 900
  },
  "heartbeat": {
    "path": "data/apex_packet_monitor_health.json"
  }
}
